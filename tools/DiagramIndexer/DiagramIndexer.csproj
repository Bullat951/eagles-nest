<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\client\Dcb.Client.Core\Dcb.Client.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WPF only renders reference glyphs for matching the charts' tiny badge letters. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Update="aliases.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>

