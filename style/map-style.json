{
  "$comment": "DCB map style, shared by the desktop client and (later) the website. Colours are CSS hex (#RRGGBB or #RRGGBBAA). Sizes, widths and dash lengths are in DIPs (= CSS px at 100 %). Dash arrays are absolute lengths [on, off, ...]. Fonts: regular, bold, mono (see fonts). Add fields freely; readers ignore what they do not know.",
  "version": 1,
  "fonts": {
    "regular": "Segoe UI",
    "bold": "Segoe UI Semibold",
    "mono": "Consolas",
    "haloWidth": 3
  },
  "identity": {
    "friendly": "#4DA3FF",
    "hostile": "#FF5A5A",
    "unknown": "#FFB347",
    "selection": "#FFFFFF"
  },
  "coalition": {
    "red": "#FF5A5A",
    "blue": "#4DA3FF",
    "neutral": "#B0B0B0"
  },
  "halo": {
    "dark": "#000000",
    "light": "#FFFFFF"
  },
  "symbols": {
    "halfSize": 6,
    "width": 1.6,
    "thinWidth": 1,
    "leaderWidth": 0.8,
    "vectorSeconds": 60,
    "selection": { "radius": 15, "width": 1.2, "dash": [2.4, 2.4] },
    "label": { "font": "mono", "size": 11, "lineHeight": 12.5 },
    "groundLabelsMaxMetersPerDip": 60
  },
  "missiles": { "size": 5, "trailWidth": 1, "trailAlpha": 0.55, "vectorSeconds": 8, "label": { "font": "mono", "size": 9 }, "targetLine": { "width": 0.8, "dash": [3, 3] } },
  "srs": { "talk": "#FFB020", "ringWidth": 2 },
  "threatRing": { "color": "#FF5A5A", "width": 0.9, "dash": [4.5, 3.6] },
  "triangulation": {
    "line": { "color": "#FFB347", "width": 1.3, "dash": [8, 4] },
    "wedgeAlpha": 0.10,
    "lengthNm": 100,
    "fadeMinutes": 15,
    "fix": { "color": "#FFE066", "width": 1.4 },
    "threat": { "color": "#FF5A5A", "ringWidth": 1.6, "ringDash": [7, 4], "fillAlpha": 0.08, "size": 8 },
    "label": { "font": "mono", "size": 11 }
  },
  "marks": { "color": "#E8E8E8", "player": "#9EE37D", "dcb": "#FF8A80", "size": 6, "label": { "font": "regular", "size": 11 } },
  "zones": {
    "width": 1.6,
    "selectedWidth": 3,
    "fillAlpha": 0.267,
    "suspendedFillAlpha": 0.133,
    "bigZoneFillFactor": 0.3,
    "suspendedDash": [4.8, 3.2],
    "minRadius": 7,
    "label": { "font": "bold", "size": 11, "maxMetersPerDip": 1500 },
    "link": { "color": "#C8C8C8B0", "width": 1.2, "dash": [7.2, 4.8] }
  },
  "theatre": {
    "border": { "color": "#E0B040", "width": 1.5, "dash": [9, 6] },
    "outsideDark": "#00000099",
    "outsideLight": "#20202080",
    "town": { "dark": "#7F93A0", "light": "#3A3A3A", "size": 10, "maxMetersPerDip": 250 }
  },
  "airfields": {
    "label": "#F0F0F0",
    "runway": "#3A3D42",
    "taxiway": "#555960",
    "marking": "#F2F2F2",
    "taxiLine": "#E8C53A",
    "parking": "#9FD8FF",
    "selected": "#FFD24A",
    "chartOutline": "#00C8FF",
    "approach": { "color": "#FFD24A", "width": 1.4, "tickWidth": 2.6, "ticksNm": [2, 5, 10] }
  },
  "measure": {
    "ink": "#FFF06E",
    "bullseye": "#E8E8E8",
    "box": "#101418C8",
    "casing": "#000000B0"
  },
  "scope": {
    "background": "#0A141C",
    "coast": { "color": "#3E7A96", "width": 1.1 },
    "lakes": { "color": "#2F5C72", "width": 0.9 },
    "borders": { "color": "#5A646E", "width": 0.9, "dash": [3.6, 2.7] }
  },
  "baseMaps": {
    "dcsBackground": "#A6C6E2",
    "webBackground": "#C8C8C8",
    "dcsSatelliteSea": "#1E3340",
    "mgrs": { "color": "#60606090", "width": 0.6 }
  }
}
