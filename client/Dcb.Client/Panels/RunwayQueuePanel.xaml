<UserControl x:Class="Dcb.Client.Panels.RunwayQueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Dcb.Panel}">
    <UserControl.Resources>
        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,6,8,4">
            <TextBlock x:Name="TitleText" Foreground="{DynamicResource Dcb.Text}" FontWeight="Bold" FontSize="12" Text="RUNWAY QUEUE"/>
            <TextBlock Foreground="{DynamicResource Dcb.TextDim}" FontSize="10" TextWrapping="Wrap"
                       Text="Order of the runway: ▲▼ move · ⏫ priority · ⇄ arrival/departure · ✕ remove"/>
            <TextBlock x:Name="GapText" Foreground="{DynamicResource Dcb.Warn}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,0,6,6">
                <ItemsControl x:Name="Strips">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Background="{DynamicResource Dcb.PanelAlt}" BorderBrush="{Binding Brush}" BorderThickness="5,1,1,1" CornerRadius="2">
                                <Grid Margin="6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PlaceText}" Foreground="{Binding Brush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource Dcb.Text}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding KindText, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource Dcb.TextDim}" FontWeight="Normal"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource Dcb.TextDim}" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding State, Mode=OneWay}" Foreground="{DynamicResource Dcb.Warn}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Detail, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource StripButton}" Content="▲" Tag="{Binding Unit}" Click="Up_Click" ToolTip="Move up one place"/>
                                        <Button Style="{StaticResource StripButton}" Content="▼" Tag="{Binding Unit}" Click="Down_Click" ToolTip="Move down one place"/>
                                        <Button Style="{StaticResource StripButton}" Content="⏫" Tag="{Binding Unit}" Click="Priority_Click" ToolTip="Priority: to the front of the queue"/>
                                        <Button Style="{StaticResource StripButton}" Content="⇄" Tag="{Binding Unit}" Click="Toggle_Click" ToolTip="Switch arrival / departure"/>
                                        <Button Style="{StaticResource StripButton}" Content="✕" Tag="{Binding Unit}" Click="Remove_Click" ToolTip="Remove from the queue"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Dcb.TextDim}" FontSize="11" Margin="2,4" Text="No aircraft in the queue."/>
                <TextBlock Foreground="{DynamicResource Dcb.Text}" FontWeight="Bold" FontSize="11" Margin="2,10,0,2" Text="SUGGESTED"/>
                <ItemsControl x:Name="Candidates">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Background="{DynamicResource Dcb.PanelAlt}" BorderBrush="{Binding Brush}" BorderThickness="2,0,0,0">
                                <DockPanel Margin="6,2">
                                    <Button DockPanel.Dock="Right" Content="{Binding AddText}" Tag="{Binding Unit}" Click="Add_Click" Padding="6,0" FontSize="11"
                                            ToolTip="Add to the end of the queue"/>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Dcb.TextDim}" FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Dcb.Text}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Type, Mode=OneWay}"/>
                                        <Run Text="{Binding Detail, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoCandidatesText" Foreground="{DynamicResource Dcb.TextDim}" FontSize="10" Margin="2,2" TextWrapping="Wrap"
                           Text="None: own aircraft closing within 15 NM, or taxiing at the base, show up here."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
