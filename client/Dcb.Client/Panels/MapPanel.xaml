<UserControl x:Class="Dcb.Client.Panels.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gpu="clr-namespace:Dcb.Client.Map.Gpu">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <TextBlock Text="Map" VerticalAlignment="Center" Margin="2,0,4,0"/>
            <ComboBox x:Name="BaseMapBox" Width="120" SelectionChanged="BaseMapBox_SelectionChanged"/>
            <TextBlock Text="Labels" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <ComboBox x:Name="LabelsBox" Width="80" SelectionChanged="LabelsBox_SelectionChanged"/>
            <CheckBox x:Name="ThreatRingsBox" Content="Threat rings" Margin="10,0,0,0" VerticalAlignment="Center"
                      Checked="ThreatRingsBox_Changed" Unchecked="ThreatRingsBox_Changed"/>
            <CheckBox x:Name="MarksBox" Content="F10 marks" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="The coalition's F10 map marks: players' (green), the mission's (white), DCB's (red)"
                      Checked="MarksBox_Changed" Unchecked="MarksBox_Changed"/>
            <CheckBox x:Name="FootholdBox" Content="Zones" Margin="10,0,0,0" VerticalAlignment="Center"
                      Checked="FootholdBox_Changed" Unchecked="FootholdBox_Changed"/>
            <CheckBox x:Name="AirfieldsBox" Content="Airfields" Margin="10,0,0,0" VerticalAlignment="Center"
                      Checked="AirfieldsBox_Changed" Unchecked="AirfieldsBox_Changed"/>
            <CheckBox x:Name="DiagramsBox" Content="Diagrams" Margin="6,0,0,0" VerticalAlignment="Center"
                      ToolTip="Airport-diagram pictures under the live airfield data (Window → Map data)"
                      Checked="DiagramsBox_Changed" Unchecked="DiagramsBox_Changed"/>
            <CheckBox x:Name="GridBox" Content="Grid" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="MGRS grid (DCS Map)" Checked="GridBox_Changed" Unchecked="GridBox_Changed"/>
            <CheckBox x:Name="GroundUnitsBox" Content="Ground units" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="Vehicles and structures (off by default in an ATC window)" Checked="TrackFilter_Changed" Unchecked="TrackFilter_Changed"/>
            <CheckBox x:Name="LandedBox" Content="Landed" Margin="10,0,0,0" VerticalAlignment="Center"
                      ToolTip="Aircraft on the ground or a carrier deck (off by default)" Checked="TrackFilter_Changed" Unchecked="TrackFilter_Changed"/>
            <TextBlock Text="Brightness" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider x:Name="BrightnessSlider" Width="90" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                    VerticalAlignment="Center" ToolTip="Dims the base map; markers, zones and labels stay bright"
                    ValueChanged="BrightnessSlider_ValueChanged"/>
            <Separator Margin="8,0"/>
            <Button Content="Fit picture" Click="Fit_Click"/>
        </ToolBar>
        <Grid x:Name="MapArea" ClipToBounds="True"
              PreviewMouseLeftButtonDown="MapArea_PreviewMouseLeftButtonDown"
              PreviewMouseLeftButtonUp="MapArea_PreviewMouseLeftButtonUp"
              PreviewMouseRightButtonDown="MapArea_PreviewMouseRightButtonDown"
              PreviewMouseRightButtonUp="MapArea_PreviewMouseRightButtonUp"
              PreviewMouseMove="MapArea_PreviewMouseMove"
              MouseLeave="MapArea_MouseLeave">
            <!-- The whole map, base map and overlays, is drawn by Skia into this one surface. -->
            <gpu:MapSurface x:Name="Surface"/>
            <TextBlock x:Name="AttributionText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="4" Padding="4,1" FontSize="10" Foreground="#DDD" Background="#80000000"
                       IsHitTestVisible="False"/>
            <!-- RWR scope around an own unit (the RWR key or its right-click menu): the emitters its
                 receiver hears; a click on one, or on any azimuth, draws that bearing line. -->
            <Canvas x:Name="RwrCanvas" Visibility="Collapsed" Background="#01000000"
                    PreviewMouseDown="RwrCanvas_PreviewMouseDown"/>
            <!-- NCTR area (the NCTR key): drag a box, pick the methods, Run. -->
            <Canvas x:Name="NctrCanvas" Visibility="Collapsed" Background="#01000000" Cursor="Cross"/>
            <!-- Alt+click: the point in every format, to read out or copy. -->
            <Popup x:Name="PointPopup" PlacementTarget="{Binding ElementName=MapArea}" Placement="Relative"
                   StaysOpen="False" AllowsTransparency="True" Closed="PointPopup_Closed" KeyDown="PointPopup_KeyDown">
                <Border Background="#F0181C22" BorderBrush="#FFF06E" BorderThickness="1" CornerRadius="3" Padding="8,6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="✕" Padding="5,0" Margin="6,0,0,0" Click="PointClose_Click"
                                    ToolTip="Close (Esc)"/>
                            <Button DockPanel.Dock="Right" Content="Copy" Padding="8,0" Click="PointCopy_Click"
                                    ToolTip="Copy all lines"/>
                            <TextBlock Text="Point" Foreground="#FFF06E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox x:Name="PointText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="#EEE" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
