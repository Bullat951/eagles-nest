<UserControl x:Class="Dcb.Client.Panels.ObjectsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <CheckBox x:Name="AirBox" Content="Air" IsChecked="True" Margin="2,0,8,0" Click="Filter_Click"/>
            <CheckBox x:Name="GroundBox" Content="Ground" IsChecked="True" Margin="0,0,8,0" Click="Filter_Click"/>
            <CheckBox x:Name="ShipsBox" Content="Ships" IsChecked="True" Margin="0,0,8,0" Click="Filter_Click"/>
            <Separator/>
            <CheckBox x:Name="OwnBox" Content="Own" IsChecked="True" Margin="8,0,8,0" Click="Filter_Click"/>
            <CheckBox x:Name="ContactsBox" Content="Contacts" IsChecked="True" Click="Filter_Click"/>
            <Separator/>
            <CheckBox x:Name="PlayersBox" Content="Players only" IsChecked="False" Margin="8,0,0,0" Click="Filter_Click"
                      ToolTip="Only aircraft flown by people"/>
        </ToolBar>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                  SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick"
                  ContextMenuOpening="Grid_ContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu/>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{Binding Brush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Lost}" Value="True">
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Pkg" SortMemberPath="Package">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding PackageBrush}" CornerRadius="2" Padding="3,0" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Package}" Foreground="Black" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding IdentityText}"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Alt" Binding="{Binding Altitude}"/>
                <DataGridTextColumn Header="Hdg" Binding="{Binding Hdg, StringFormat=000}"/>
                <DataGridTextColumn Header="Kt" Binding="{Binding Speed, StringFormat=F0}"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
