<Window x:Class="Dcb.Client.Panels.SendMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send to player" Width="520" Height="520" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="FieldText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="AtisButton" Content="ATIS" IsChecked="True" Margin="0,0,14,0" Checked="Kind_Checked"/>
                <RadioButton x:Name="InfoButton" Content="Airfield info" Checked="Kind_Checked"/>
            </StackPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="To" Width="60" VerticalAlignment="Center"/>
                <ComboBox x:Name="PlayerBox" DisplayMemberPath="Label"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Show for" Width="60" VerticalAlignment="Center"/>
                <ComboBox x:Name="SecondsBox" Width="90" HorizontalAlignment="Left"/>
            </DockPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Padding="12,2" Margin="6,0,0,0" IsCancel="True" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" x:Name="SendButton" Content="Send" Padding="16,2" IsDefault="True" Click="Send_Click"/>
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource Dcb.TextDim}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Shown as a text box on the player's screen (not chat). Edit freely before sending."/>
        <TextBox x:Name="MessageText" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MaxLength="1400"/>
    </DockPanel>
</Window>
