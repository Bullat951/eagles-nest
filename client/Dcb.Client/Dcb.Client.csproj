<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dcb.Client.Core\Dcb.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Map surface: SKGLElement (Skia on OpenGL) and SKElement (Skia on the CPU). -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- SkiaSharp.Views.WPF's OpenGL support depends on OpenTK packaged for .NET Framework only. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\basemap.json" />
    <!-- Shared with the website: the repository's style/ folder is the one source. -->
    <EmbeddedResource Include="..\..\style\map-style.json" LogicalName="map-style.json" />
  </ItemGroup>

</Project>


